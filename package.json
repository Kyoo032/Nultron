{
  "name": "agentforge",
  "private": true,
  "description": "Closed-beta local workbench for the Toko Token AI gateway",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false .",
    "lint:fix": "biome check --write .",
    "test:e2e": "pnpm --filter @agentforge/web test:e2e",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:nix": "nix flake check -L --keep-going",
    "ci:nix:fast": "node scripts/nix-ci.mjs --fast",
    "ci:nix:cache-warm": "node scripts/nix-ci.mjs --warm-cache",
    "db:push": "pnpm --filter @agentforge/db push",
    "db:seed": "pnpm --filter @agentforge/db seed",
    "db:studio": "pnpm --filter @agentforge/db studio",
    "portal:dev": "pnpm --filter @agentforge/portal exec tsx src/main.ts",
    "portal:seed": "pnpm --filter @agentforge/portal exec tsx scripts/seed.ts",
    "portal:otp": "pnpm --filter @agentforge/portal exec tsx scripts/otp.ts",
    "portal:invite": "pnpm --filter @agentforge/portal exec tsx scripts/invite.ts",
    "portal:account": "pnpm --filter @agentforge/portal exec tsx scripts/account.ts",
    "maps:check": "node scripts/map-rot.mjs",
    "verify:paid-gate": "node .cursor/skills/verify-paid-media-gate/scripts/check.mjs",
    "formal:settle": "node scripts/formal/chat-run-settle.mjs",
    "formal:sync-check": "node scripts/formal-sync-check.mjs",
    "lane-guard": "node scripts/lane-guard.mjs",
    "where": "node scripts/where-am-i.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "maps:drift": "node scripts/map-drift.mjs",
    "edit:starters": "node scripts/edit-starters.mjs",
    "edit:starters:check": "node scripts/edit-starters.mjs --check",
    "videos:examples": "node scripts/video-examples.mjs",
    "videos:examples:check": "node scripts/video-examples.mjs --check",
    "sandbox:build": "node scripts/build-sandbox-runtime.mjs",
    "sandbox:verify": "node scripts/build-sandbox-runtime.mjs --verify",
    "desktop:dev": "pnpm --filter @agentforge/desktop desktop-dev",
    "desktop:build": "pnpm --filter @agentforge/desktop desktop-build",
    "desktop:release": "pnpm --filter @agentforge/desktop desktop-release",
    "desktop:build:all": "pnpm --filter @agentforge/desktop desktop-build-all",
    "desktop:build:mac": "pnpm --filter @agentforge/desktop desktop-build-mac",
    "desktop:build:mac:dir": "pnpm --filter @agentforge/desktop desktop-build-mac-dir",
    "desktop:build:mac:docker": "pnpm --filter @agentforge/desktop desktop-build-mac-docker",
    "desktop:mac": "node apps/desktop/scripts/macos-app.mjs",
    "desktop:build:linux": "pnpm --filter @agentforge/desktop desktop-build-linux"
  },
  "pnpm": {
    "overrides": {
      "jsondiffpatch@<0.7.6": ">=0.7.6",
      "image-size@<2.0.3": ">=2.0.3",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "body-parser@2": "2.4.0",
      "@ai-sdk/provider-utils>undici": "6.29.1",
      "@hono/node-server": "2.1.9",
      "builder-util-runtime": "9.7.1",
      "fast-uri": "3.1.9",
      "hono": "4.13.19",
      "ip-address": "10.7.6",
      "postcss-selector-parser": "6.1.6",
      "qs": "6.17.1",
      "source-map-js": "1.2.2",
      "tar": "7.5.23",
      "tinypool": "2.1.2",
      "uuid": "11.1.1",
      "vite": "7.3.8"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "pyodide": "314.0.7",
    "quickjs-emscripten-core": "0.32.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
