# Every name the production overlay's Secret (`nultron-secrets`) carries. COPY to secrets.env (gitignored)
# and fill each value from the secret manager. NEVER generate the wrap key on a laptop for a real deploy,
# and never reuse a rehearsal value. Names, not values, are all that belong in git.
#
# 32-byte hex wrap key (openssl rand -hex 32). Generate ONCE and keep it forever: a new key cannot
# read the data the old one sealed.
AGENTFORGE_SECRETS_KEY=
# Shared secret the payment provider signs the billing webhook with. Required in production.
AGENTFORGE_BILLING_WEBHOOK_SECRET=
# This app's confidential client at the portal. The secret is printed once by the portal's seed.
AGENTFORGE_PORTAL_CLIENT_ID=
AGENTFORGE_PORTAL_CLIENT_SECRET=
# Portal: Ed25519 seed (32 bytes, base64url). Rotating it signs every user out (SR-24).
PORTAL_SIGNING_KEY=
# Portal database: the schema owner's password, and portal_app_login's. Different values.
PORTAL_POSTGRES_PASSWORD=
PORTAL_APP_DB_PASSWORD=
# The mail provider login for one-time codes. Both or neither.
PORTAL_SMTP_USER=
PORTAL_SMTP_PASS=
# Backup archive passphrase. Keep a copy OUTSIDE the cluster.
BACKUP_KEY=
