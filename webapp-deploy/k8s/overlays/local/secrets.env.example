# Every name the local overlay's Secret (`nultron-secrets`) carries. COPY to secrets.env, or let
# `node webapp-deploy/k8s/rehearse-local.mjs` generate it with strong random values on first run.
# secrets.env is gitignored. Never put a real value in this example, and never reuse a rehearsal
# value anywhere else.
#
# Hosted app (hostedEnvProblems in packages/host/src/hosted-env.ts refuses to boot without these)
# 32-byte hex wrap key for stored secrets. Generate once and keep it: a new key cannot read old data.
AGENTFORGE_SECRETS_KEY=
# Shared secret the payment provider signs the billing webhook with (hex, 32 bytes).
AGENTFORGE_BILLING_WEBHOOK_SECRET=
# This app's confidential client at the portal. The id is the seed default (<tenant>-web). The secret
# is printed ONCE by the portal's seed; the rehearsal script captures it and writes it here.
AGENTFORGE_PORTAL_CLIENT_ID=
AGENTFORGE_PORTAL_CLIENT_SECRET=
# Portal stand-in (apps/portal/README.md, Environment)
# Ed25519 seed: 32 bytes as base64url, base64 or hex.
PORTAL_SIGNING_KEY=
# The schema owner's password (Postgres superuser `portal`: runs migrations, serves nothing).
PORTAL_POSTGRES_PASSWORD=
# portal_app_login's password: the role the portal serves as (printable ASCII).
PORTAL_APP_DB_PASSWORD=
# Backup CronJob
# Passphrase for the archive (AES-256-GCM via aead-crypt.mjs, SR-171). Keep a copy outside the cluster: a backup you cannot decrypt is not one.
BACKUP_KEY=
