# Nultron hosted web app - the PORTAL side's environment template.
# Copy to portal.env next to compose.yml and fill it in. NEVER commit portal.env, and never put a
# real secret in this file: these are placeholders, and a secret that has been in git has to be
# treated as published.
#
#   cp portal.env.example portal.env && chmod 600 portal.env
#
# Loaded ONLY by the portal, portal-prepare and portal-db services. The app and the proxy never see
# it: a portal signing key in the app container would let anyone who got into the app mint sign-in
# tokens, and an SMTP password would let them send mail as Nultron (SR-73 is the same rule for the
# proxy). The app's own settings are in .env.
#
# Not set here, on purpose, and refused by the portal in production if you do: PORTAL_ALLOW_MANUAL_OTP
# (SR-10) and PORTAL_DEV_OUTBOX. compose.yml pins the rest: NODE_ENV=production, PORTAL_TRUST_PROXY=1,
# PORTAL_PUBLIC_URL=https://$PORTAL_DOMAIN and the data dir.

# ---------------------------------------------------------------------------
# Signing key
# ---------------------------------------------------------------------------

# (required) The Ed25519 seed that signs every access token: 32 bytes, as 64 hex characters.
#   openssl rand -hex 32
# Generate once. ROTATING IT SIGNS EVERYONE OUT (SR-24): the portal publishes only the key held in its
# own process, so the old public key leaves the JWKS the moment the container restarts and every token
# minted under it stops verifying. Treat it as set-once, and tell the testers before you change it.
PORTAL_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Database: the portal's own Postgres (the portal-db service). Never DATABASE_URL, which is the app's.
# Both passwords must be URL-safe, because they are placed in a DSN; `openssl rand -hex 24` is.
# ---------------------------------------------------------------------------

# (required) The schema owner's password. portal-db reads it once, on an empty volume (changing it
# later does not change the database), and the portal's migrations log in with it.
PORTAL_POSTGRES_PASSWORD=
# (required) portal_app_login's password: the role the portal SERVES as. portal-prepare sets it on the
# server on every `up`, so rotating it is "edit this file, docker compose up -d". Not the same value
# as the one above.
PORTAL_APP_DB_PASSWORD=

# A managed Postgres (TencentDB) instead of the portal-db service: set these and delete the service.
# PORTAL_DB_HOST=
# PORTAL_DB_PORT=5432
# PORTAL_DB_OWNER=portal

# ---------------------------------------------------------------------------
# How people sign in (optional; owner decision 2026-10-07, for one white-label deployment)
#
# Left unset, the portal e-mails a one-time code, and the SMTP settings below are required. To sign people
# in with a username and a password instead, uncomment the line below and nothing else changes in this file:
# no e-mail is ever sent, the SMTP settings below are not needed (blank or deleted is fine), and nobody
# signs themselves up. An operator makes each person, and the generated initial password is printed once:
#
#   sh scripts/portal.sh account create --username <name> --email <address> --role owner|admin|member
#   sh scripts/portal.sh account list | reset-password | disable | enable | set-role
#
# (In the released bundle there is no scripts/ folder: the same thing is `docker compose exec -T portal sh
# /app/webapp-deploy/portal-entry.sh ./node_modules/.bin/tsx scripts/account.ts <command> ...`.) The values
# are exactly `code` and `password`; anything else stops the portal at boot. A second factor is being
# designed and is not built (SR-165). `portal.sh invite` and `otp` refuse to run in this mode.
# ---------------------------------------------------------------------------

# PORTAL_SIGNIN_MODE=password

# ---------------------------------------------------------------------------
# Sign-in mail: Tencent Cloud SES over SMTP (owner decision 2026-10-01)
#
# Only for the e-mailed code, which is the default; not needed when PORTAL_SIGNIN_MODE=password.
# The portal e-mails a one-time code. It refuses to boot in production without a real mail host, and it
# never sends a code or an SMTP login in the clear (SR-39).
#
# SES, International site: host sg-smtp.qcloudmail.com, port 465, implicit TLS. SES documents 465 as its
# SMTP port and says port 25 is disabled; its own samples open TLS before speaking SMTP (Go tls.Dial,
# Python SMTP_SSL), so the portal's PORTAL_SMTP_SECURE=1 is the matching mode and needs no code change.
# (The China-site hosts are smtp.qcloudmail.com for Hong Kong and gz-smtp.qcloudmail.com for Guangzhou; an
# account on tencentcloud.com uses sg-smtp.) Sources: README.md, "Phase 0 pilot (compose)".
#
# Before it works, in the SES console: verify the sender domain (SPF, DKIM and DMARC records), create a
# sender address on it, and set an SMTP password for that address. The SMTP user is the SENDER ADDRESS
# and the password is the one set in the console, NOT the Tencent Cloud login and NOT an API key.
# SES also limits one sender to 10 messages an hour to the same recipient, and SMTP is closed to new
# accounts that were activated under individual real-name verification after 2026-03-02.
# ---------------------------------------------------------------------------

PORTAL_SMTP_HOST=sg-smtp.qcloudmail.com
PORTAL_SMTP_PORT=465
PORTAL_SMTP_SECURE=1
# The verified sender address, in full: no-reply@mail.example.com
PORTAL_SMTP_USER=
# The SMTP password set for that address in the SES console.
PORTAL_SMTP_PASS=
# The From header, shown in the testers' inbox. Its address must be the verified sender above.
PORTAL_SMTP_FROM=Nultron <no-reply@mail.example.com>
