node_modules
.next
dist
.turbo
.env
.env.local
# The product's default data dir (localDataDir(): <package>/../../data, i.e. this folder). It holds
# .master-key, settings.enc, session.enc (the portal refresh token), the SQLite desk, media, meeting
# recordings and unpacked native components. Ignored as a whole, not as a list of names, so a file
# the product starts writing tomorrow is never one `git add` away from a commit. The leading slash
# anchors it here: a source folder called `data` anywhere else stays tracked. Nothing under data/
# is tracked; if a file ever has to be, ignore `/data/*` instead and add a `!/data/<name>` line.
# See docs/internal/security-register.md, SR-19.
/data/
.cursor-artifacts/
*.log
coverage
playwright-report
test-results
.cursor/skills/verify-agentforge/evidence/**
!.cursor/skills/verify-agentforge/evidence/README.md
apps/web/tests/fixtures/edit/*.mp4
apps/web/tests/fixtures/edit/*.png
assets/starters/*.mp4
assets/starters/*.m4a
assets/examples/videos/*.mp4
.DS_Store
*.tsbuildinfo
.claude/*
!.claude/rules/
_ref/

# Python bytecode from the mac build tooling
__pycache__/
*.pyc

# isolated verification instance data (PORT=3100)
.verify-*/

# Webdev and review data directories. These hold `.master-key` and the desk SQLite file, so an
# untracked one is a `git add -A` away from a committed wrap key. `.webdev-data*` also covers the
# dated backups (`.webdev-data.bak-20260921/`). See docs/internal/security-register.md, SR-02.
.webdev-data*/
.nultron-review/
.dpsbuddy-review/

# Review-harness secrets and TLS material. `scripts/review-instance.ps1` writes review.env under
# $HOME and `scripts/review-proxy.mjs` generates its key pair there, but `--cert-dir` takes any
# path, so the repo refuses the file rather than trusting the flag.
review.env
*.pem

# Local CI logs (scripts/ci-local.mjs). Per-run step logs and summary.md; never committed.
.ci-local/

# Local Nix GC-root pins written by scripts/nix-ci.mjs; never committed.
.nix-ci-roots/

# tools/nultron-3d is outside the pnpm workspace: its own npm install, the render output, and scratch (previews, logs, look renders).
tools/nultron-3d/node_modules/
tools/nultron-3d/out/
tools/nultron-3d/work/

# Nultron working files (marketing videos, brand art, IP filings, deploy decks). Local only, never committed.
nultron-files/

# Kubernetes rehearsal (webapp-deploy/k8s). The local overlay's secrets.env holds generated wrap, signing,
# database and backup keys, and pki/ holds the private keys of a throwaway CA; .local/ holds the generated
# overlay, the build snapshot and the port-forward state. None of it is ever committed.
webapp-deploy/k8s/overlays/*/secrets.env
webapp-deploy/k8s/overlays/*/pki/
webapp-deploy/k8s/.local/
# Compose rehearsal (webapp-deploy/pilot-local.mjs): generated env files, a throwaway CA's private keys and
# the transformed Caddyfile. Never committed; also excluded from every Docker build context.
webapp-deploy/.pilot-local/
# The pilot stack's real env files on a server checkout. The app's .env is covered by `.env*` above.
webapp-deploy/portal.env

# Code-sandbox runtime (scripts/build-sandbox-runtime.mjs): the built Pyodide + QuickJS folder that ships as
# resources/sandbox in the installer and /app/sandbox in the image, and the download cache for its pinned wheels.
# Rebuilt from scripts/sandbox-runtime.lock.json; never committed.
vendor/sandbox-runtime/
vendor/sandbox-runtime.tmp-*/
vendor/.sandbox-cache/

# Third-party reference clones (read-only, never committed)
.ref/

# Nix build outputs (nix build writes these symlinks into the working directory).
/result
/result-*
