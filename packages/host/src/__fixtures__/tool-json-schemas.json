      "type": "integer",
      "minimum": 12,
      "maximum": 200
     },
     "primaryColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "hex8 #RRGGBBAA"
     },
     "outlineColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "hex8 #RRGGBBAA"
     },
     "outlinePx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
     },
     "shadowPx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
     },
     "bold": {
      "type": "boolean"
     },
     "italic": {
      "type": "boolean"
     },
     "alignment": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
     },
     "marginL": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
     },
     "marginR": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
     },
     "marginV": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
     },
     "box": {
      "type": "object",
      "properties": {
       "color": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{8}$",
        "description": "hex8 #RRGGBBAA"
       }
      },
      "required": [
       "color"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "fontFamily",
     "fontSizePx",
     "primaryColor",
     "outlineColor",
     "outlinePx",
     "shadowPx",
     "bold",
     "italic",
     "alignment",
     "marginL",
     "marginR",
     "marginV"
    ],
    "additionalProperties": false
   },
   "startFrame": {
    "type": "integer",
    "minimum": 0
   },
   "durationFrames": {
    "type": "integer",
    "minimum": 1
   },
