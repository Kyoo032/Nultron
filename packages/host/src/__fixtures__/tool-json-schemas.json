 "build_deck": {
  "type": "object",
  "properties": {
   "title": {
    "type": "string",
    "description": "The deck's title, shown on the first slide (at most 200 characters)"
   },
   "slides": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "section",
        "bullets",
        "split",
        "close"
       ],
       "default": "bullets",
       "description": "section opens a part, bullets is the normal slide, split puts a short aside beside the bullets, close ends the deck"
      },
      "heading": {
       "type": "string",
       "description": "The slide's claim, as a short sentence (at most 200 characters)"
      },
      "subhead": {
       "type": "string",
       "default": "",
       "description": "One line under the heading (at most 300 characters)"
      },
      "bullets": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "description": "Three to five short points: at most 12, each at most 400 characters"
      },
      "aside": {
       "type": "string",
       "default": "",
       "description": "Only for a split slide: the short callout (at most 600 characters)"
      },
      "notes": {
       "type": "string",
       "default": "",
       "description": "What the presenter says on this slide (at most 2000 characters)"
      }
     },
     "required": [
      "heading"
     ],
     "additionalProperties": false
    },
    "description": "One to 14 slides after the title slide, in the order they are shown"
   }
  },
  "required": [
   "title",
   "slides"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
 },
