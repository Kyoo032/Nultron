     "legal",
     "meeting",
     "images",
     "videos",
     "music",
     "edit",
     "presentations",
     "education"
    ],
    "description": "Which agent to ask. It must be one on the owner's desk; if it is not, the answer names the ones that are."
   },
   "task": {
    "type": "string",
    "minLength": 8,
    "maxLength": 4000,
