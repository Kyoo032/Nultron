  "en/desk-pending-electron": "<section class=\"mt-6 space-y-4 rounded-xl border border-[var(--line)] bg-[var(--surface)] p-4\" data-testid=\"settings-reset\"><div><h2 class=\"font-medium text-[var(--text)]\">Start over</h2><p class=\"mt-1 text-xs text-[var(--text-3)]\">Forget the gateway key on this machine, or delete everything and get the fresh-install experience back.</p></div><div class=\"mt-3 space-y-3 rounded-md border border-[var(--danger)]/30 bg-[var(--danger)]/5 p-3\" data-testid=\"settings-reset-pending\"><p class=\"text-sm text-[var(--text)]\">A full reset is queued for the next launch.</p><div class=\"flex flex-wrap items-center gap-2\"><button type=\"button\" class=\"rounded-md px-3 py-2 text-sm text-[var(--text-2)] underline disabled:opacity-50\" data-testid=\"settings-reset-pending-cancel\">Keep my data</button><button type=\"button\" class=\"rounded-pill bg-[var(--danger)] px-3 py-1.5 text-sm text-[var(--surface)] disabled:opacity-50\" data-testid=\"settings-reset-pending-restart\">Restart now</button></div></div><details class=\"space-y-3\" data-testid=\"settings-reset-danger\"><summary class=\"cursor-pointer text-sm font-medium text-[var(--text)]\">Sign out and delete</summary><div class=\"space-y-1\"><div class=\"flex flex-wrap items-center justify-between gap-2\"><p class=\"text-sm text-[var(--text)]\">Sign out of the gateway</p><button type=\"button\" class=\"rounded-md px-2 py-1 text-sm text-[var(--danger)] underline disabled:opacity-50\" data-testid=\"settings-reset-key\">Sign out</button></div><p class=\"text-xs text-[var(--text-3)]\">Forgets the saved key on every desk and sends you back to the first-run screen. Threads, desks, knowledge, and files stay.</p></div><div class=\"space-y-1 border-t border-[var(--line)] pt-4\"><div class=\"flex flex-wrap items-center justify-between gap-2\"><p class=\"text-sm text-[var(--text)]\">Reset to a fresh install</p><button type=\"button\" class=\"rounded-md px-2 py-1 text-sm text-[var(--danger)] underli